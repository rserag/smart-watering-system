POSTGRES_DB=watering
POSTGRES_USER=watering
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

DEVICE_SHARED_TOKEN=replace-with-the-token-used-by-the-esp32
SERVER_CONFIG_VERSION=1
HTTPS_PORT=8443
GATEWAY_PORT=8008

# Use development for local review, then switch to google after filling the OAuth values.
AUTH_MODE=development
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_HOURS=12
DEVELOPMENT_USER_EMAIL=local-reviewer@example.com
DEVELOPMENT_USER_NAME="Local reviewer"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAILS=your-google-account@example.com
FRONTEND_URL=https://localhost:8443
CORS_ORIGINS=https://localhost:8443,https://127.0.0.1:8443

# Create a bot with @BotFather, then use the target chat ID from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
